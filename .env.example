# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1

# Logging Configuration
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.log

# Source Collection Configuration
COLLECTION_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

# Verification Configuration
MIN_CONFIDENCE_THRESHOLD=50
ENABLE_MULTI_AUTHORITY_VERIFICATION=true

# Change Detection Configuration
MONITORING_INTERVAL=3600
ENABLE_REAL_TIME_ALERTS=true

# Storage Configuration
STORAGE_MODE=local
# Options: local, aws, hybrid
# local: File-based storage (default)
# aws: DynamoDB + S3 storage
# hybrid: Write to both local and AWS

# AWS Configuration (required when STORAGE_MODE=aws or hybrid)
AWS_REGION=us-east-1
ENVIRONMENT=dev
# Environment affects resource naming: verigov-{env}-*

# AI Provider Configuration
AI_PROVIDER=groq
# Options: groq, bedrock, multi
# groq: Use Groq API only (default)
# bedrock: Use AWS Bedrock only
# multi: Use both and compare results
